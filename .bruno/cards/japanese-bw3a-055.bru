meta {
  name: Japanese BW3a-055 printing metadata
  type: http
  seq: 31
}

get {
  url: {{BASE_URL}}/v2/ja/cards/BW3a-055
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq BW3a-055
  res.body.name: eq ミュウツーEX
  res.body.illustrator: eq 5ban Graphics
  res.body.hp: eq 170
  res.body.dexId[0]: eq 150
  res.body.set.id: eq BW3a
  res.body.variants.normal: eq false
  res.body.variants.holo: eq true
  res.body.variants.reverse: eq false
  res.body.variants.firstEdition: eq true
  res.body.variants_detailed.length: eq 2
}
