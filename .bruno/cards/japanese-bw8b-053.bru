meta {
  name: Japanese BW8b-053 printing metadata
  type: http
  seq: 33
}

get {
  url: {{BASE_URL}}/v2/ja/cards/BW8b-053
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq BW8b-053
  res.body.name: eq ラティアスEX
  res.body.illustrator: eq Ryo Ueda
  res.body.hp: eq 160
  res.body.set.id: eq BW8b
  res.body.variants.normal: eq false
  res.body.variants.holo: eq true
  res.body.variants.reverse: eq false
  res.body.variants.firstEdition: eq true
  res.body.variants_detailed.length: eq 2
}
